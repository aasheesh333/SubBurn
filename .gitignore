# Presentation scratch output. Committed renders and goldens are tracked below;
# do not ignore *.png globally — that also dropped the Android launcher icons.
/renders/_debug/
/renders/audit/
!/renders/*.png
!/renders/*.json
!/renders/svg/**
!/renders/figma-png/**
!/flutter/test/goldens/**
!**/android/app/src/main/res/mipmap-*/**

# Flutter / Dart
flutter/.dart_tool/
flutter/build/
flutter/.flutter-plugins
flutter/.flutter-plugins-dependencies
flutter/.packages
flutter/pubspec.lock.bak
**/*.iml
**/.idea/
**/.vscode/

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# Local secrets and machine state
**/local.properties
**/key.properties
*.jks
*.keystore
!flutter/android/app/debug.keystore
.env
.env.*

# Firebase service-account keys (server-side only, never client config)
*firebase-adminsdk*.json
*service-account*.json
serviceAccountKey.json

# Cloudflare wrangler state
.wrangler/
site/.wrangler/

# Golden-test failure output (regenerated locally on a diff)
flutter/test/failures/
