<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme while the process starts. The background matches the app's
         own surface so there is no flash, and light/dark follows the device
         through values-night rather than forcing black. -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/sb_background</item>
    </style>
</resources>
