<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash screen. Without these the system
         falls back to a generic render of the window background, and some
         OEM recents/splash paths showed the framework's default mark instead
         of SubBurn's. The foreground layer is transparent around a centred
         flame, so the system's circular mask crops cleanly. -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/sb_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
