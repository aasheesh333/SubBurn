<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer policy.
     The ledger in Hive is the user's financial data; it must never leave the
     device through Google backup or a device-to-device transfer. The app can
     rebuild everything except the subscriptions themselves, so excluding the
     whole app is the honest choice. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
